@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="medical-container">
    <!-- Status Messages -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i>
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            @successMessage
        </div>
    }

    @if (isSaving)
    {
        <div class="alert alert-info">
            <i class="fas fa-spinner fa-spin"></i>
            Saving...
        </div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info">
            <i class="fas fa-spinner fa-spin"></i>
            Loading patients...
        </div>
    }

    <!-- Main Grid Layout -->
    <div class="main-grid">
        <!-- Left Column -->
        <div class="left-column">
            <!-- Patient Info Card -->
            <div class="compact-card">
                <div class="card-header">
                    <i class="fas fa-user"></i>
                    <h3>Patient Information</h3>
                </div>
                <div class="compact-form">
                    <div class="form-row">
                        <div class="input-group">
                            <label>Gender</label>
                            <select class="form-input">
                                <option>Male</option>
                                <option>Female</option>
                            </select>
                        </div>
                        <div class="input-group">
                            <label>Age</label>
                            <input type="text" class="form-input" placeholder="Age">
                        </div>
                    </div>
                    <div class="form-row">
    <div class="input-group search-group">
        <label>Patient Name</label>
        <div class="patient-search-controls">
            <div class="search-container">
                <i class="fas fa-search search-icon"></i>
                <input type="text" 
                       class="form-input" 
                       placeholder="Search patient or enter new patient name..."
                       @bind="patientSearchText"
                       @bind:event="oninput" />
            </div>
            @if (!string.IsNullOrEmpty(patientSearchText) && !isNewPatient)
            {
                <button class="btn btn-success btn-sm" 
                        @onclick="() => CreateNewPatientFromSearch()">
                    <i class="fas fa-user-plus"></i> New Patient
                </button>
            }
        </div>
    </div>
</div>

@if (isNewPatient)
{
    <div class="new-patient-form">
        <div class="form-row">
            <div class="input-group">
                <label>Gender</label>
                <select class="form-input" @bind="newPatientGender">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="input-group">
                <label>Age</label>
                <input type="text" 
                       class="form-input" 
                       placeholder="Age"
                       @bind="newPatientAge" />
            </div>
        </div>
        <div class="form-row">
            <div class="input-group">
                <label>Mobile</label>
                <input type="text" 
                       class="form-input" 
                       placeholder="Mobile"
                       @bind="newPatientMobile" />
            </div>
        </div>
        <div class="form-row">
            <button class="btn btn-primary btn-sm" 
                    @onclick="SaveNewPatientDetails">
                <i class="fas fa-check"></i> Save Details
            </button>
            <button class="btn btn-danger btn-sm" 
                    @onclick="CancelNewPatient">
                <i class="fas fa-times"></i> Cancel
            </button>
        </div>
    </div>
}
                    <div class="form-row">
                        <div class="input-group">
                            <label>Mobile</label>
                            <input type="text" 
       class="form-input" 
       placeholder="Mobile" 
       @bind="patientMobile"
       disabled="@selectedPatientId.HasValue">
                        </div>
                        <div class="input-group">
                            <label>Consultation Fee</label>
                            <input type="number" 
                                   class="form-input" 
                                   placeholder="Fee"
                                   @bind="consultationFee">
                        </div>
                    </div>
                    @if (selectedPatientId.HasValue)
                    {
                        <div class="form-row">
                            <div class="selected-patient-info">
                                <span class="patient-badge">
                                    <i class="fas fa-check-circle"></i>
                                    Selected: @patients.FirstOrDefault(p => p.Id == selectedPatientId)?.Name
                                </span>
                                <button class="btn btn-sm btn-danger" @onclick="ClearPatientSelection">
                                    <i class="fas fa-times"></i> Clear
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Address Card -->
            <div class="compact-card">
                <div class="card-header">
                    <i class="fas fa-map-marker-alt"></i>
                    <h3>Address</h3>
                </div>
                <textarea class="form-textarea" 
          placeholder="Patient address..." 
          rows="2"
          @bind="patientAddress"
          disabled="@selectedPatientId.HasValue"></textarea>
            </div>

            <!-- Visit Signs Card -->
            <div class="compact-card">
                <div class="card-header">
                    <i class="fas fa-heartbeat"></i>
                    <h3>Visit Signs</h3>
                </div>
                <div class="vitals-grid">
                    <div class="vital-item">
                        <label>BP</label>
                        <input type="text" 
                               class="form-input" 
                               placeholder="120/80"
                               @bind="bloodPressure">
                    </div>
                    <div class="vital-item">
                        <label>SPO2</label>
                        <input type="number" 
                               class="form-input" 
                               placeholder="100"
                               @bind="spo2">
                    </div>
                    <div class="vital-item">
                        <label>Temp °C</label>
                        <input type="number" 
                               class="form-input" 
                               placeholder="37"
                               @bind="temperature">
                    </div>
                    <div class="vital-item">
                        <label>Pulse</label>
                        <input type="number" 
                               class="form-input" 
                               placeholder="72"
                               @bind="pulse">
                    </div>
                    <div class="vital-item">
                        <label>Weight</label>
                        <input type="text" 
                               class="form-input" 
                               placeholder="75kg"
                               @bind="weight">
                    </div>
                    <div class="vital-item">
                        <label>Diagnosis</label>
                        <input type="text" 
                               class="form-input" 
                               placeholder="Fever, Cough..."
                               @bind="diagnosis">
                    </div>
                </div>
            </div>
        </div>

        <!-- Center Column -->
        <div class="center-column">
            <!-- Medicine Prescription with Template Search -->
            <div class="compact-card">
                <div class="card-header-with-template">
                    <div class="card-header">
                        <i class="fas fa-pills"></i>
                        <h3>Medicine Prescription</h3>
                    </div>
                    <div class="template-search">
                        <div class="search-container">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" 
                                   class="form-input template-input" 
                                   placeholder="Search templates...">
                        </div>
                    </div>
                </div>

                <div class="medicine-controls">
                    <div class="input-group">
                        <div class="search-container">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" 
                                   class="form-input" 
                                   placeholder="Search medicine"
                                   @bind="medicineSearch">
                        </div>
                    </div>
                    <div class="input-group">
                        <select class="form-input" @bind="selectedDoseId">
                            <option value="">Select Dose</option>
                            <option value="@Guid.NewGuid()">500mg</option>
                            <option value="@Guid.NewGuid()">250mg</option>
                            <option value="@Guid.NewGuid()">100mg</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <input type="number" 
                               class="form-input" 
                               placeholder="Days"
                               @bind="durationDays">
                    </div>
                    <button class="btn btn-primary btn-small" @onclick="AddMedicine">
                        <i class="fas fa-plus"></i>
                        Add
                    </button>
                </div>

                <!-- Medicine Table -->
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Medicine</th>
                                <th>Dose</th>
                                <th>Duration</th>
                                <th>Instructions</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (medicines.Any())
                            {
                                @for (int i = 0; i < medicines.Count; i++)
                                {
                                    var medicine = medicines[i];
                                    <tr>
                                        <td>Medicine @i</td>
                                        <td>@(medicine.DoseId.ToString().Substring(0, 8))...</td>
                                        <td>@medicine.DurationDays days</td>
                                        <td>@medicine.Instructions</td>
                                        <td>
                                            <button class="icon-btn danger" 
                                                    title="Delete"
                                                    @onclick="@(() => RemoveMedicine(i))">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center">No medicines added</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Medical Advice Section -->
                <div class="advice-section">
                    <div class="input-group">
                        <label>Medical Advice</label>
                        <div class="advice-controls">
                            <div class="search-container">
                                <i class="fas fa-search search-icon"></i>
                                <input type="text" 
                                       class="form-input" 
                                       placeholder="Add advice..."
                                       @bind="adviceSearch">
                            </div>
                            <button class="btn btn-primary btn-small" @onclick="AddAdvice">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        </div>
                        @if (selectedAdvice.Any())
                        {
                            <div class="advice-list">
                                @for (int i = 0; i < selectedAdvice.Count; i++)
                                {
                                    <div class="advice-item">
                                        <span>@selectedAdvice[i]</span>
                                        <button class="icon-btn danger btn-sm" 
                                                @onclick="@(() => RemoveAdvice(i))">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- OPD History with Date Filter -->
            <div class="compact-card">
                <div class="card-header-with-template">
                    <div class="card-header">
                        <i class="fas fa-history"></i>
                        <h3>OPD History</h3>
                    </div>
                    <div class="date-filter-controls">
                        <div class="date-input-group">
                            <div class="date-container">
                                <i class="fas fa-calendar date-icon"></i>
                                <input type="date" class="form-input date-input">
                            </div>
                        </div>
                        <div class="date-input-group">
                            <div class="date-container">
                                <i class="fas fa-calendar date-icon"></i>
                                <input type="date" class="form-input date-input">
                            </div>
                        </div>
                        <button class="btn btn-primary btn-view">
                            <i class="fas fa-eye"></i>
                            View
                        </button>
                    </div>
                </div>
                <div class="table-container small-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Complaint</th>
                                <th>Medicine</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (selectedPatientId.HasValue)
                            {
                               @*  <!-- This would be populated with actual patient history --> *@
                                <tr>
                                    <td colspan="4" class="text-center">
                                        @if (isLoading)
                                        {
                                            <i class="fas fa-spinner fa-spin">Loading history...</i> 
                                        }
                                        else
                                        {
                                            <span>No history found for this patient</span>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <span>Select a patient to view history</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="right-column">
            <!-- Patient Complaints - Simplified -->
            <div class="compact-card">
                <div class="card-header">
                    <i class="fas fa-comment-medical"></i>
                    <h3>Patient Complaints</h3>
                </div>
                <div class="complaints-controls-simple">
                    <div class="input-group">
                        <div class="search-container">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" 
                                   class="form-input" 
                                   placeholder="Add complaint..."
                                   @bind="complaintInput"
                                   @onkeypress="@(e => {
                                       if (e.Key == "Enter") AddComplaint();
                                   })" />
                        </div>
                    </div>
                    <button class="btn btn-primary btn-small" @onclick="AddComplaint">
                        <i class="fas fa-plus"></i>
                        Add
                    </button>
                </div>
                <div class="table-container small-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Complaint</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (complaints.Any())
                            {
                                @for (int i = 0; i < complaints.Count; i++)
                                {
                                    <tr>
                                        <td>@complaints[i]</td>
                                        <td>
                                            <button class="icon-btn danger" 
                                                    title="Delete"
                                                    @onclick="@(() => RemoveComplaint(i))">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center">No complaints added</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- History & Follow Up -->
            <div class="compact-card">
                <div class="card-header">
                    <i class="fas fa-notes-medical"></i>
                    <h3>History & Follow Up</h3>
                </div>
                <div class="follow-up-controls">
                    <div class="form-row">
                        <div class="input-group">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="setFollowUp" />
                                <span>Set Follow-up</span>
                            </label>
                        </div>
                        @if (setFollowUp)
                        {
                            <div class="input-group">
                                <input type="number" 
                                       class="form-input" 
                                       placeholder="Days"
                                       @bind="followUpDays" />
                            </div>
                        }
                    </div>
                </div>
                <textarea class="form-textarea" 
                          placeholder="Follow up notes, next visit instructions, patient progress..." 
                          rows="5"
                          @bind="followUpNotes"></textarea>
            </div>

            <!-- Payment Mode -->
            <div class="compact-card">
                <div class="card-header">
                    <i class="fas fa-credit-card"></i>
                    <h3>Payment</h3>
                </div>
                <div class="payment-controls">
                    <div class="input-group">
                        <label>Payment Mode</label>
                        <select class="form-input" @bind="paymentMode">
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="UPI">UPI</option>
                            <option value="Insurance">Insurance</option>
                        </select>
                    </div>
                    <div class="fee-display">
                        <label>Consultation Fee:</label>
                        <span class="fee-amount">₹ @consultationFee</span>
                    </div>
                </div>
            </div>

            <!-- Compact Actions -->
            <div class="compact-card">
                <div class="card-header">
                    <i class="fas fa-tasks"></i>
                    <h3>Actions</h3>
                </div>
                <div class="action-buttons-compact">
                    <div class="action-group">
                        <button class="btn btn-success btn-compact" 
                                title="Save Prescription"
                                @onclick="SavePrescription"
                                disabled="@isSaving">
                            <i class="fas fa-save"></i>
                            Save
                        </button>
                        <button class="btn btn-primary btn-compact" 
                                title="Save and Print"
                                @onclick="SaveAndPrint"
                                disabled="@isSaving">
                            <i class="fas fa-print"></i>
                            Print
                        </button>
                    </div>
                    <div class="action-group">
                        <button class="btn btn-info btn-compact" 
                                title="Quick Consultation"
                                @onclick="QuickConsultation"
                                disabled="@isSaving">
                            <i class="fas fa-bolt"></i>
                            Quick
                        </button>
                        <button class="btn btn-warning btn-compact" 
                                title="Ultra Quick"
                                @onclick="UltraQuickConsultation"
                                disabled="@isSaving">
                            <i class="fas fa-running"></i>
                            Ultra
                        </button>
                    </div>
                    <div class="action-group">
                        <button class="btn btn-info btn-compact" 
                                title="Print Bill"
                                @onclick="PrintBill">
                            <i class="fas fa-file-invoice"></i>
                            Bill
                        </button>
                        <button class="btn btn-danger btn-compact" 
                                title="Clear All"
                                @onclick="ResetForm"
                                disabled="@isSaving">
                            <i class="fas fa-broom"></i>
                            Clear
                        </button>
                    </div>
                </div>
                <div class="refresh-section">
                    <button class="btn btn-secondary btn-sm" @onclick="RefreshData">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

